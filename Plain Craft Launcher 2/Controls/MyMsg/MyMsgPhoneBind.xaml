<Grid x:Class="PCL.MyMsgPhoneBind"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:my="clr-namespace:PCL"
      RenderTransformOrigin="0,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="460"
      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
    <Grid.RenderTransform>
        <TransformGroup>
            <RotateTransform x:Name="TransformRotate" Angle="-4" />
            <TranslateTransform x:Name="TransformPos" X="0" Y="40" />
        </TransformGroup>
    </Grid.RenderTransform>
    <Border Name="PanBorder" CornerRadius="7" Background="{DynamicResource ColorBrushBackground}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ColorObjectMsgBoxShadow}" BlurRadius="20" ShadowDepth="2"
                              RenderingBias="Performance" Opacity="0.8" x:Name="EffectShadow" />
        </Border.Effect>
        <Grid Name="PanMain" VerticalAlignment="Top" Margin="22,22,22,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="13" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="23" TextTrimming="None" Foreground="{DynamicResource ColorBrush2}"
                       HorizontalAlignment="Left" Name="LabTitle" Margin="7,-1,70,9" Text="绑定手机号"
                       VerticalAlignment="Top" SnapsToDevicePixels="False" UseLayoutRounding="False" />
            <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="2" Fill="{Binding Foreground, ElementName=LabTitle}" />
            <TextBlock Grid.Row="3" Name="LabText" TextWrapping="Wrap" FontSize="13" LineHeight="18"
                       Opacity="0.8" Margin="7,0,7,12" />

            <DockPanel Grid.Row="4" Margin="7,0,7,10" Height="30">
                <TextBlock DockPanel.Dock="Left" Text="手机号" Width="64" VerticalAlignment="Center" Opacity="0.75" />
                <TextBlock DockPanel.Dock="Left" Text="+86" Width="36" VerticalAlignment="Center" Opacity="0.85"
                           FontFamily="Consolas" />
                <my:MyTextBox x:Name="TextMobile" MaxLines="1" AcceptsReturn="False" MaxLength="11"
                              HintText="11 位手机号" />
            </DockPanel>

            <DockPanel Grid.Row="5" Margin="7,0,7,10" Height="30">
                <TextBlock DockPanel.Dock="Left" Text="人机验证" Width="64" VerticalAlignment="Center" Opacity="0.75" />
                <my:MyButton x:Name="BtnRefreshCaptcha" DockPanel.Dock="Right" Text="换一题"
                             ColorType="Normal" Width="72" Margin="10,0,0,0" Click="BtnRefreshCaptcha_Click" />
                <TextBlock x:Name="LabCaptcha" DockPanel.Dock="Right" Margin="12,0" FontFamily="Consolas"
                           FontSize="14" VerticalAlignment="Center" Opacity="0.85" Text="…" />
                <my:MyTextBox x:Name="TextCaptcha" MaxLines="1" AcceptsReturn="False" HintText="答案" />
            </DockPanel>

            <DockPanel Grid.Row="6" Margin="7,0,7,10" Height="30">
                <my:MyButton x:Name="BtnSendCode" DockPanel.Dock="Left" Text="发送验证码"
                             ColorType="Normal" Width="108" Click="BtnSendCode_Click" />
                <TextBlock x:Name="LabSmsHint" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <DockPanel Grid.Row="7" Margin="7,0,7,10" Height="30">
                <TextBlock DockPanel.Dock="Left" Text="验证码" Width="64" VerticalAlignment="Center" Opacity="0.75" />
                <my:MyTextBox x:Name="TextCode" MaxLines="1" AcceptsReturn="False" MaxLength="6"
                              HintText="6 位数字" />
            </DockPanel>

            <TextBlock Grid.Row="8" x:Name="LabStatus" Margin="7,0,7,10" FontSize="12" TextWrapping="Wrap"
                       Opacity="0.75" />

            <StackPanel Grid.Row="9" Name="PanBtn" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Margin="150,0,8,0" Orientation="Horizontal">
                <my:MyButton ColorType="Normal" x:FieldModifier="public" Text="稍后再说" x:Name="BtnLater"
                             Margin="12,0,0,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0"
                             Click="BtnLater_Click" />
                <my:MyButton ColorType="Highlight" x:FieldModifier="public" Text="绑定手机号" x:Name="BtnBind"
                             Margin="12,0,0,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0"
                             Click="BtnBind_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Grid>
