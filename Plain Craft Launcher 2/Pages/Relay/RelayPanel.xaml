<UserControl x:Class="PCL.RelayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <StackPanel Margin="10,0,10,10">

        <!-- 顶部：房间状态 -->
        <DockPanel Margin="0,4,0,10">
            <local:MyButton x:Name="BtnStop" DockPanel.Dock="Right" Text="关闭房间"
                            ColorType="Normal" Width="96" Visibility="Collapsed" Click="BtnStop_Click" />
            <TextBlock x:Name="LabStatus" Text="就绪" Opacity="0.7" Margin="0,0,12,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- 地区限制：服务端按来源 IP 判定不在中国大陆时显示，此时登录与分配都不可用 -->
        <local:MyCard x:Name="PanRegionBlocked" Margin="0,0,0,10" Title="地区限制" Visibility="Collapsed">
            <StackPanel Margin="14,32,14,14">
                <TextBlock Text="当前可能位于非中国大陆地区，暂时无法使用此功能" TextWrapping="Wrap"
                           FontSize="14" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"
                           Text="中继联机服务仅面向中国大陆地区开放。如果你确实在中国大陆，可能是网络出口被判定了其他地区，可以尝试更换网络后重新打开本页。" />
            </StackPanel>
        </local:MyCard>

        <!-- 登录状态 -->
        <local:MyCard Margin="0,0,0,10" Title="登录状态">
            <StackPanel Margin="14,32,14,14">
                <DockPanel>
                    <local:MyButton x:Name="BtnLogout" DockPanel.Dock="Right" Text="退出登录"
                                    ColorType="Normal" Width="96" VerticalAlignment="Center"
                                    Visibility="Collapsed" Click="BtnLogout_Click" />
                    <local:MyButton x:Name="BtnBindPhone" DockPanel.Dock="Right" Text="绑定手机号"
                                    ColorType="Highlight" Width="96" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Visibility="Collapsed" Click="BtnBindPhone_Click" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- 状态点：未登录灰、已登录绿、已过期橙、已封禁红 -->
                            <Ellipse x:Name="DotAuth" Width="8" Height="8" Margin="0,0,8,0"
                                     VerticalAlignment="Center" Fill="#9CA3AF" />
                            <TextBlock x:Name="LabAccount" Text="未登录" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="LabAccountSub" Text="登录后即可创建或加入房间" Opacity="0.7"
                                   Margin="16,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </local:MyCard>

        <!-- 登录 -->
        <local:MyCard x:Name="PanLogin" Margin="0,0,0,10" Title="登录">
            <StackPanel Margin="14,32,14,14">
                <TextBlock Text="使用邮箱验证码登录，首次登录会自动创建账号。" Opacity="0.7"
                           TextWrapping="Wrap" Margin="0,0,0,12" />

                <DockPanel Margin="0,0,0,10" Height="28">
                    <TextBlock DockPanel.Dock="Left" Text="邮箱" Width="64" VerticalAlignment="Center" Opacity="0.75" />
                    <local:MyTextBox x:Name="TextEmail" MaxLines="1" AcceptsReturn="False"
                                     HintText="you@example.com" />
                </DockPanel>

                <DockPanel Margin="0,0,0,10" Height="28">
                    <TextBlock DockPanel.Dock="Left" Text="人机验证" Width="64" VerticalAlignment="Center" Opacity="0.75" />
                    <local:MyButton x:Name="BtnRefreshCaptcha" DockPanel.Dock="Right" Text="换一题"
                                    ColorType="Normal" Width="76" Margin="10,0,0,0"
                                    Click="BtnRefreshCaptcha_Click" />
                    <TextBlock x:Name="LabCaptcha" DockPanel.Dock="Right" Margin="12,0" FontFamily="Consolas"
                               FontSize="14" VerticalAlignment="Center" Opacity="0.85" />
                    <local:MyTextBox x:Name="TextCaptcha" MaxLines="1" AcceptsReturn="False"
                                     HintText="答案" />
                </DockPanel>

                <DockPanel Margin="0,0,0,10" Height="28">
                    <local:MyButton x:Name="BtnSendCode" DockPanel.Dock="Left" Text="发送验证码"
                                    ColorType="Normal" Width="110" Click="BtnSendCode_Click" />
                    <TextBlock x:Name="LabCodeHint" Margin="12,0,0,0" VerticalAlignment="Center"
                               Opacity="0.7" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <DockPanel Height="28">
                    <TextBlock DockPanel.Dock="Left" Text="验证码" Width="64" VerticalAlignment="Center" Opacity="0.75" />
                    <local:MyButton x:Name="BtnLogin" DockPanel.Dock="Right" Text="登录 / 注册"
                                    ColorType="Highlight" Width="110" Margin="10,0,0,0"
                                    Click="BtnLogin_Click" />
                    <local:MyTextBox x:Name="TextCode" MaxLines="1" AcceptsReturn="False"
                                     HintText="6 位数字" />
                </DockPanel>
            </StackPanel>
        </local:MyCard>

        <!-- 配额 -->
        <local:MyCard x:Name="PanQuota" Margin="0,0,0,10" Title="我的配额" Visibility="Collapsed">
            <StackPanel Margin="14,32,14,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="本月流量" Opacity="0.7" />
                        <TextBlock x:Name="LabTraffic" Text="—" Margin="0,6,0,0" FontSize="14" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="带宽限速" Opacity="0.7" />
                        <TextBlock x:Name="LabRate" Text="—" Margin="0,6,0,0" FontSize="14" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="房间数" Opacity="0.7" />
                        <TextBlock x:Name="LabPorts" Text="—" Margin="0,6,0,0" FontSize="14" />
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="BarTraffic" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="1"
                             BorderThickness="0"
                             Foreground="{DynamicResource ColorBrush1}"
                             Background="{DynamicResource ColorBrush7}" />
            </StackPanel>
        </local:MyCard>

        <local:MyCard Margin="0,0,0,10" Title="加入房间">
            <StackPanel Margin="14,32,14,14">
                <TextBlock Text="输入朋友分享的房间码，加入后在游戏的多人游戏列表中选择“中继房间”即可进入。"
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" />
                <DockPanel Height="28">
                    <local:MyButton x:Name="BtnJoin" DockPanel.Dock="Right" Text="加入房间"
                                    ColorType="Highlight" Width="96" Margin="10,0,0,0" Click="BtnJoin_Click" />
                    <local:MyTextBox x:Name="TextRoomCode" MaxLength="64" MaxLines="1" AcceptsReturn="False"
                                     HintText="PCLCE-ABCDE-FGHJK-LMNPQ-RSTUV" FontFamily="Consolas" />
                </DockPanel>
                <StackPanel x:Name="PanJoinedRoom" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="LabJoinedName" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="LabJoinedCode" FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="保持启动器运行，打开《我的世界》→ 多人游戏，等待局域网列表出现此房间。请使用与房主相同的游戏版本和模组。"
                               Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </local:MyCard>

        <local:MyCard Margin="0,0,0,10" Title="创建房间">
            <StackPanel Margin="14,32,14,14">
                <TextBlock Text="先进入游戏世界，在暂停菜单中选择“对局域网开放”。创建时会自动识别并验证游戏，房间码由云端生成。"
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" />
                <DockPanel Height="28" Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Text="节点" Width="48" VerticalAlignment="Center" Opacity="0.7" />
                    <local:MyComboBox x:Name="ComboNodes" DropDownWidthSync="False" />
                </DockPanel>
                <DockPanel MinHeight="28" Margin="0,0,0,8">
                    <local:MyButton x:Name="BtnAllocate" DockPanel.Dock="Right" Text="创建房间"
                                    ColorType="Highlight" Width="96" Margin="10,0,0,0" Click="BtnAllocate_Click" />
                    <local:MyButton x:Name="BtnScan" DockPanel.Dock="Right" Text="扫描游戏"
                                    ColorType="Normal" Width="96" Margin="10,0,0,0" Click="BtnScan_Click" />
                    <local:MyComboBox x:Name="ComboGames" DropDownWidthSync="False" Visibility="Collapsed" />
                </DockPanel>
                <TextBlock x:Name="LabScanHint" Text="请在游戏内开启局域网联机。"
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,14" />
                <TextBlock x:Name="LabEmpty" Text="还没有创建的房间" Opacity="0.6" Margin="0,0,0,4" />
                <ListBox x:Name="ListRooms" MinHeight="44" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                                    Background="{DynamicResource ColorBrush7}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <local:MyButton Text="复制码" ColorType="Normal" Width="64" IsEnabled="{Binding CanCopy}"
                                                        Tag="{Binding}" Click="BtnCopy_Click" />
                                        <local:MyButton Text="关闭" ColorType="Normal" Width="64" Margin="8,0,0,0"
                                                        Tag="{Binding}" Click="BtnRelease_Click" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding RoomCode}" FontFamily="Consolas" TextWrapping="Wrap"
                                                   FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Opacity="0.7" Margin="0,6,0,0" TextWrapping="Wrap">
                                            <!-- Run.Text 默认 TwoWay，计算属性需要显式 OneWay。 -->
                                            <Run Text="{Binding NodeName, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Label, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding StateText, Mode=OneWay}" />
                                            <Run Text=" · 已用 " />
                                            <Run Text="{Binding UsageText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </local:MyCard>
        <TextBlock Text="中继联机服务说明" FontWeight="SemiBold" Opacity="0.65" Margin="5,8,5,0" />
        <TextBlock Text="本中继联机服务由独立服务提供方运营，与 PCLCE 官方及龙腾猫跃无关。服务可用性、账号与使用限制由服务提供方负责；联机问题请联系本服务维护者。"
                   TextWrapping="Wrap" Opacity="0.55" FontSize="12" Margin="5,8,5,15" />
    </StackPanel>
</UserControl>
