<UserControl x:Class="PCL.RelayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <StackPanel Margin="10,0,10,10">

        <!-- 顶部：状态 + 强制停隧道 -->
        <DockPanel Margin="0,4,0,10">
            <local:MyButton x:Name="BtnStop" DockPanel.Dock="Right" Text="停止隧道"
                            ColorType="Normal" Width="96" Visibility="Collapsed" Click="BtnStop_Click" />
            <TextBlock x:Name="LabStatus" Text="就绪" Opacity="0.7" Margin="0,0,12,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- 登录状态 -->
        <local:MyCard Margin="0,0,0,10" Title="登录状态">
            <StackPanel Margin="14,32,14,14">
                <DockPanel>
                    <local:MyButton x:Name="BtnLogout" DockPanel.Dock="Right" Text="退出登录"
                                    ColorType="Normal" Width="96" VerticalAlignment="Center"
                                    Visibility="Collapsed" Click="BtnLogout_Click" />
                    <local:MyButton x:Name="BtnBindPhone" DockPanel.Dock="Right" Text="绑定手机号"
                                    ColorType="Highlight" Width="96" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Visibility="Collapsed" Click="BtnBindPhone_Click" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- 状态点：未登录灰、已登录绿、已过期橙、已封禁红 -->
                            <Ellipse x:Name="DotAuth" Width="8" Height="8" Margin="0,0,8,0"
                                     VerticalAlignment="Center" Fill="#9CA3AF" />
                            <TextBlock x:Name="LabAccount" Text="未登录" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="LabAccountSub" Text="登录后即可分配中继端口" Opacity="0.7"
                                   Margin="16,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </local:MyCard>

        <!-- 登录 -->
        <local:MyCard x:Name="PanLogin" Margin="0,0,0,10" Title="登录">
            <StackPanel Margin="14,32,14,14">
                <TextBlock Text="使用邮箱验证码登录，首次登录会自动创建账号。" Opacity="0.7"
                           TextWrapping="Wrap" Margin="0,0,0,12" />

                <DockPanel Margin="0,0,0,10" Height="28">
                    <TextBlock DockPanel.Dock="Left" Text="邮箱" Width="64" VerticalAlignment="Center" Opacity="0.75" />
                    <local:MyTextBox x:Name="TextEmail" MaxLines="1" AcceptsReturn="False"
                                     HintText="you@example.com" />
                </DockPanel>

                <DockPanel Margin="0,0,0,10" Height="28">
                    <TextBlock DockPanel.Dock="Left" Text="人机验证" Width="64" VerticalAlignment="Center" Opacity="0.75" />
                    <local:MyButton x:Name="BtnRefreshCaptcha" DockPanel.Dock="Right" Text="换一题"
                                    ColorType="Normal" Width="76" Margin="10,0,0,0"
                                    Click="BtnRefreshCaptcha_Click" />
                    <TextBlock x:Name="LabCaptcha" DockPanel.Dock="Right" Margin="12,0" FontFamily="Consolas"
                               FontSize="14" VerticalAlignment="Center" Opacity="0.85" />
                    <local:MyTextBox x:Name="TextCaptcha" MaxLines="1" AcceptsReturn="False"
                                     HintText="答案" />
                </DockPanel>

                <DockPanel Margin="0,0,0,10" Height="28">
                    <local:MyButton x:Name="BtnSendCode" DockPanel.Dock="Left" Text="发送验证码"
                                    ColorType="Normal" Width="110" Click="BtnSendCode_Click" />
                    <TextBlock x:Name="LabCodeHint" Margin="12,0,0,0" VerticalAlignment="Center"
                               Opacity="0.7" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <DockPanel Height="28">
                    <TextBlock DockPanel.Dock="Left" Text="验证码" Width="64" VerticalAlignment="Center" Opacity="0.75" />
                    <local:MyButton x:Name="BtnLogin" DockPanel.Dock="Right" Text="登录 / 注册"
                                    ColorType="Highlight" Width="110" Margin="10,0,0,0"
                                    Click="BtnLogin_Click" />
                    <local:MyTextBox x:Name="TextCode" MaxLines="1" AcceptsReturn="False"
                                     HintText="6 位数字" />
                </DockPanel>
            </StackPanel>
        </local:MyCard>

        <!-- 配额 -->
        <local:MyCard x:Name="PanQuota" Margin="0,0,0,10" Title="我的配额" Visibility="Collapsed">
            <StackPanel Margin="14,32,14,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="本月流量" Opacity="0.7" />
                        <TextBlock x:Name="LabTraffic" Text="—" Margin="0,6,0,0" FontSize="14" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="带宽限速" Opacity="0.7" />
                        <TextBlock x:Name="LabRate" Text="—" Margin="0,6,0,0" FontSize="14" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="端口数" Opacity="0.7" />
                        <TextBlock x:Name="LabPorts" Text="—" Margin="0,6,0,0" FontSize="14" />
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="BarTraffic" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="1"
                             BorderThickness="0"
                             Foreground="{DynamicResource ColorBrush1}"
                             Background="{DynamicResource ColorBrush7}" />
            </StackPanel>
        </local:MyCard>

        <!-- 端口 -->
        <local:MyCard Margin="0,0,0,10" Title="中继端口">
            <StackPanel Margin="14,32,14,14">
                <DockPanel Height="28" Margin="0,0,0,12">
                    <local:MyButton x:Name="BtnAllocate" DockPanel.Dock="Right" Text="分配并启动"
                                    ColorType="Highlight" Width="112" Margin="10,0,0,0"
                                    Click="BtnAllocate_Click" />
                    <local:MyTextBox x:Name="TextLocalPort" DockPanel.Dock="Right" Width="88" Text="25565"
                                     MaxLines="1" AcceptsReturn="False" />
                    <TextBlock DockPanel.Dock="Right" Text="本地端口" VerticalAlignment="Center"
                               Opacity="0.7" Margin="10,0,8,0" />
                    <local:MyComboBox x:Name="ComboNodes" DropDownWidthSync="False" />
                </DockPanel>

                <TextBlock x:Name="LabEmpty" Text="还没有分配的端口" Opacity="0.6" Margin="0,0,0,4" />

                <ListBox x:Name="ListPorts" MinHeight="88" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                                    Background="{DynamicResource ColorBrush7}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <local:MyButton Text="复制" ColorType="Normal" Width="64"
                                                        Tag="{Binding}" Click="BtnCopy_Click" />
                                        <local:MyButton Text="释放" ColorType="Normal" Width="64" Margin="8,0,0,0"
                                                        Tag="{Binding}" Click="BtnRelease_Click" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding GameAddress}" FontFamily="Consolas"
                                                   FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Opacity="0.7" Margin="0,6,0,0" TextWrapping="Wrap">
                                            <!-- Run.Text 在 WPF 中默认 TwoWay 绑定，PortItem 是只读计算属性，必须显式 OneWay，否则模板一实例化就 XamlParseException -->
                                            <Run Text="{Binding NodeName, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Label, Mode=OneWay}" />
                                            <Run Text=" · 已用 " />
                                            <Run Text="{Binding UsageText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </local:MyCard>
    </StackPanel>
</UserControl>
