<local:MyPageRight x:Class="PCL.PageLinkP2P"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL" PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">
            <local:MyCard Title="P2P 联机" Margin="0,15,0,10">
                <StackPanel Margin="25,40,25,18">
                    <StackPanel Orientation="Horizontal">
                        <local:MyRadioBox x:Name="RadioHost" Text="我是房主" Checked="True" Check="RadioMode_Check" />
                        <local:MyRadioBox x:Name="RadioJoin" Text="我是玩家" Margin="28,0,0,0" Check="RadioMode_Check" />
                    </StackPanel>
                    <TextBlock x:Name="LabModeHint" Text="请在游戏内开启局域网联机。" TextWrapping="Wrap" Opacity="0.7" Margin="0,12,0,0" />
                    <DockPanel Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnAccount" Text="登录账号" DockPanel.Dock="Right" Width="100" Click="BtnAccount_Click" />
                        <TextBlock x:Name="LabAccount" Text="正在获取云端配置…" TextWrapping="Wrap" Opacity="0.7" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel x:Name="PanLogin" Visibility="Collapsed" Margin="0,12,0,0">
                        <local:MyTextBox x:Name="TextEmail" HintText="邮箱" MaxLines="1" AcceptsReturn="False" Margin="0,0,0,10" />
                        <DockPanel Margin="0,0,0,10">
                            <local:MyButton x:Name="BtnCaptcha" Text="换一题" Width="80" DockPanel.Dock="Right" Click="BtnCaptcha_Click" />
                            <TextBlock x:Name="LabCaptcha" Text="正在获取验证码…" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <local:MyButton x:Name="BtnSendCode" Text="发送验证码" Width="110" DockPanel.Dock="Right" Margin="10,0,0,0" Click="BtnSendCode_Click" />
                            <local:MyTextBox x:Name="TextCaptcha" HintText="人机验证答案" MaxLines="1" AcceptsReturn="False" />
                        </DockPanel>
                        <DockPanel>
                            <local:MyButton x:Name="BtnLogin" Text="登录 / 注册" Width="110" DockPanel.Dock="Right" Margin="10,0,0,0" Click="BtnLogin_Click" />
                            <local:MyTextBox x:Name="TextEmailCode" HintText="邮件验证码" MaxLines="1" AcceptsReturn="False" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="NAT 检测" Margin="0,0,0,10">
                <StackPanel Margin="25,40,25,18">
                    <local:MyButton x:Name="BtnDetectNat" Text="检测网络" Width="120" HorizontalAlignment="Left" Click="BtnDetectNat_Click" />
                    <TextBlock x:Name="LabNatType" Text="尚未检测" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="LabNatAdvice" Text="创建或加入前将自动检测网络可用性。" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="房间" Margin="0,0,0,10">
                <StackPanel Margin="25,40,25,18">
                    <StackPanel x:Name="PanHost">
                        <DockPanel Height="30" Margin="0,0,0,12">
                            <TextBlock Text="会合节点" DockPanel.Dock="Left" Width="72" VerticalAlignment="Center" Opacity="0.7" />
                            <local:MyComboBox x:Name="ComboNodes" DropDownWidthSync="False" />
                        </DockPanel>
                        <local:MyComboBox x:Name="ComboGames" DropDownWidthSync="False" Visibility="Collapsed" Margin="0,0,0,12" />
                    </StackPanel>
                    <local:MyTextBox x:Name="TextJoinCode" Height="30" MaxLength="64" MaxLines="1" AcceptsReturn="False"
                                     HintText="请输入完整的五组房间码" Visibility="Collapsed" Margin="0,0,0,12" />
                    <DockPanel x:Name="PanCode" Margin="0,0,0,12" Visibility="Collapsed">
                        <local:MyButton x:Name="BtnCopyCode" Text="复制码" DockPanel.Dock="Right" Width="72" Click="BtnCopyCode_Click" />
                        <TextBlock x:Name="LabCode" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <local:MyButton x:Name="BtnStart" Text="创建房间" ColorType="Highlight" Width="120" Click="BtnStart_Click" />
                        <local:MyButton x:Name="BtnStop" Text="关闭房间" ColorType="Red" Width="100" Margin="10,0,0,0" Visibility="Collapsed" Click="BtnStop_Click" />
                    </StackPanel>
                    <TextBlock x:Name="LabStatus" Text="未连接" Margin="0,14,0,0" TextWrapping="Wrap" Opacity="0.8" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="高级设置" CanSwap="True" IsSwapped="True" Margin="0,0,0,10">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock Text="网络协议" Opacity="0.7" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <local:MyRadioBox x:Name="RadioIpAuto" Text="自动" Checked="True" Check="RadioIp_Check" />
                        <local:MyRadioBox x:Name="RadioIpV4" Text="IPv4" Margin="28,0,0,0" Check="RadioIp_Check" />
                        <local:MyRadioBox x:Name="RadioIpV6" Text="IPv6" Margin="28,0,0,0" Check="RadioIp_Check" />
                    </StackPanel>
                    <TextBlock Text="默认使用自动。更改后在下次连接时生效。" Opacity="0.7" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>