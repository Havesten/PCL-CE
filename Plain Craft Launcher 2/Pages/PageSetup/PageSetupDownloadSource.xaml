<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageSetupDownloadSource"
    PanScroll="{Binding ElementName=PanBack}"
    xmlns:loc="https://ce.pclc.cc/core/localization">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">
            <local:MyCard Margin="0,15" Title="{loc:Loc Setup.DownloadSource.Pin.Title}">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock Text="{loc:Loc Setup.DownloadSource.Pin.Description}" TextWrapping="Wrap"
                               LineHeight="20" Opacity="0.72" />
                    <local:MyCheckBox x:Name="CheckPin" Margin="0,14,0,0"
                                      Text="{loc:Loc Setup.DownloadSource.Pin.Enable}"
                                      Change="CheckPin_Change"
                                      ToolTip="{loc:Loc Setup.DownloadSource.Pin.Enable.ToolTip}" />
                    <TextBlock x:Name="LabProxyWarning" Margin="0,10,0,0" TextWrapping="Wrap"
                               LineHeight="20" Opacity="0.72" Visibility="Collapsed"
                               Text="{loc:Loc Setup.DownloadSource.Proxy.Warning}" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnProbe" MinWidth="150" Padding="13,0"
                                        Text="{loc:Loc Setup.DownloadSource.Probe.Start}"
                                        ColorType="Highlight" HorizontalAlignment="Left"
                                        Click="BtnProbe_Click" />
                        <local:MyButton x:Name="BtnSpeedTest" Grid.Column="1" MinWidth="150" Padding="13,0"
                                        Margin="12,0,0,0"
                                        Text="{loc:Loc Setup.DownloadSource.Speed.Start}"
                                        HorizontalAlignment="Left" Click="BtnSpeedTest_Click" />
                        <local:MyButton x:Name="BtnClear" Grid.Column="2" MinWidth="120" Padding="13,0"
                                        Margin="12,0,0,0" Text="{loc:Loc Setup.DownloadSource.Clear}"
                                        HorizontalAlignment="Left" Click="BtnClear_Click" />
                    </Grid>
                    <Grid Margin="0,18,0,0" Height="6">
                        <Border x:Name="BarTrack" CornerRadius="3" Background="{DynamicResource ColorBrush7}"
                                Opacity="0.22" SizeChanged="BarTrack_SizeChanged" />
                        <Border x:Name="BarValue" CornerRadius="3" Background="{DynamicResource ColorBrush3}"
                                HorizontalAlignment="Left" Width="0" />
                    </Grid>
                    <TextBlock x:Name="LabStatus" Margin="0,10,0,0" Opacity="0.72" TextWrapping="Wrap"
                               Text="{loc:Loc Setup.DownloadSource.Idle}" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,15" Title="{loc:Loc Setup.DownloadSource.Nodes.Title}">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock Text="{loc:Loc Setup.DownloadSource.Nodes.Description}" TextWrapping="Wrap"
                               LineHeight="20" Opacity="0.6" Margin="0,0,0,14" />
                    <StackPanel x:Name="PanNodes" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
